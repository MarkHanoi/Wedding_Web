{
  "name": "@workspace/cloudflare-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:create": "wrangler d1 create wedding-rsvp",
    "db:migrate:local": "wrangler d1 migrations apply wedding-rsvp --local",
    "db:migrate:remote": "wrangler d1 migrations apply wedding-rsvp --remote"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "~5.9.3",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
