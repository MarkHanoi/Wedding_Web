        <mxCell id="UAi9NhBBes3vZrtYa2Oh-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=none;" value="&lt;p&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;WORLD RULES-BASED ENGINE&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;:&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;P&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 16px;&quot;&gt;rogrammed rule-based system (from the definition of laws, constraints and generative logic to their computational implementation) producing a structured world model whose form, behaviour and organisation emerges entirely from the rules that govern it.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="540" x="2473" y="3000" as="geometry" />
